SIM ?= verilator
TOPLEVEL_LANG := verilog
COCOTB_TOPLEVEL := ifu_pipeline_tb_top
COCOTB_TEST_MODULES := test_ifu_pipeline
REPO_ROOT := $(abspath ../../..)
VERILOG_SOURCES := $(REPO_ROOT)/rtl/common/o3_platform_pkg.sv \
 $(REPO_ROOT)/rtl/common/o3_cfg_pkg.sv $(REPO_ROOT)/rtl/common/o3_isa_pkg.sv \
 $(REPO_ROOT)/rtl/common/o3_types_pkg.sv $(REPO_ROOT)/rtl/frontend/rvc_expander.sv \
 $(REPO_ROOT)/rtl/frontend/ifu_f0.sv $(REPO_ROOT)/rtl/frontend/ifu_decode_queue.sv \
 $(REPO_ROOT)/rtl/frontend/ifu_f1.sv $(CURDIR)/ifu_pipeline_tb_top.sv
SIM_BUILD := $(CURDIR)/sim_build/pipeline
EXTRA_ARGS += --timing --assert -Wno-fatal
include $(shell cocotb-config --makefiles)/Makefile.sim
