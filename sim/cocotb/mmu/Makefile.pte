SIM ?= verilator
TOPLEVEL_LANG := verilog
COCOTB_TOPLEVEL := pte_cache_tb_top
COCOTB_TEST_MODULES := test_pte_cache
REPO_ROOT := $(abspath ../../..)
VERILOG_SOURCES := $(REPO_ROOT)/rtl/common/o3_isa_pkg.sv $(REPO_ROOT)/rtl/common/o3_platform_pkg.sv $(REPO_ROOT)/rtl/common/o3_cfg_pkg.sv $(REPO_ROOT)/rtl/common/o3_types_pkg.sv $(REPO_ROOT)/rtl/common/o3_pkg.sv $(wildcard $(REPO_ROOT)/rtl/lsu/dcache*.sv) $(REPO_ROOT)/rtl/lsu/lrsc_reservation.sv $(CURDIR)/pte_cache_tb_top.sv
COCOTB_RESULTS_FILE := $(CURDIR)/pte-results.xml
export SETS=64
export WAYS=8
export MSHRS=4
export WBS=2
export RFO=1
export PYTHONPATH := $(REPO_ROOT)/sim/cocotb/dcache:$(PYTHONPATH)
TEST_SEED ?= 1
export TEST_SEED
EXTRA_ARGS += --timing -Wno-fatal --assert
include $(shell cocotb-config --makefiles)/Makefile.sim
