SIM ?= verilator
TOPLEVEL_LANG := verilog
COCOTB_TOPLEVEL := fetch_buffer_payload_tb_top
COCOTB_TEST_MODULES := test_payload
REPO_ROOT := $(abspath ../../..)
VERILOG_SOURCES := $(REPO_ROOT)/rtl/common/o3_isa_pkg.sv \
  $(REPO_ROOT)/rtl/common/o3_platform_pkg.sv $(REPO_ROOT)/rtl/common/o3_cfg_pkg.sv \
  $(REPO_ROOT)/rtl/common/o3_types_pkg.sv $(REPO_ROOT)/rtl/frontend/fetch_buffer.sv \
  $(CURDIR)/fetch_buffer_payload_tb_top.sv
TEST_SEED ?= 1
export TEST_SEED
EXTRA_ARGS += --timing --assert -Wno-fatal
include $(shell cocotb-config --makefiles)/Makefile.sim
