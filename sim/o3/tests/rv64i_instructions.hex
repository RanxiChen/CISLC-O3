# U-type and RV64 word operations, followed by taken BEQ/JAL recovery checks.
800000b7 # lui   x1,0x80000        -> ffffffff80000000
00001117 # auipc x2,0x1            -> 0000000000001004
0010819b # addiw x3,x1,1           -> ffffffff80000001
0011921b # slliw x4,x3,1           -> 0000000000000002
0011d29b # srliw x5,x3,1           -> 0000000040000000
4011d31b # sraiw x6,x3,1           -> ffffffffc0000000
003183bb # addw  x7,x3,x3          -> 0000000000000002
4030043b # subw  x8,x0,x3          -> 000000007fffffff
004194bb # sllw  x9,x3,x4          -> 0000000000000004
0041d53b # srlw  x10,x3,x4         -> 0000000020000000
4041d5bb # sraw  x11,x3,x4         -> ffffffffe0000000
00438463 # beq   x7,x4,+8          -> skip wrong path
00100613 # addi  x12,x0,1          -> must be squashed
008006ef # jal   x13,+8            -> link=0x38, skip wrong path
00200713 # addi  x14,x0,2          -> must be squashed
00300793 # addi  x15,x0,3          -> 3
